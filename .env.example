# You do not need to touch this file. START.bat copies it to .env automatically
# on first run, and falls back to the next free port if the one below is busy.
# Edit .env (not this file) only if you want to pin a specific port.

# The packaged app is a single process: the backend serves the built frontend
# directly, so WAE_BACKEND_PORT is the only port that matters for START.bat -
# that is the URL the browser opens (e.g. http://localhost:8021).
# Change it if something else on this machine already listens there
# (START.bat tells you exactly what is holding a port, and falls back to the
# next free one automatically for that run without editing this file).
WAE_BACKEND_PORT=8021
WAE_BACKEND_HOST=127.0.0.1

# Only used by `npm run dev` (frontend/) for live-reload local development -
# START.bat/stop.bat/status.bat never start a separate frontend process.
WAE_FRONTEND_PORT=5185

# Where the database, uploads, exports, reports and logs are written.
# Defaults to <project>/data
# WAE_DATA_DIR=C:\path\to\data

# Maximum CSV upload size in bytes (default 64 MB)
# WAE_MAX_UPLOAD_BYTES=67108864

# Extra browser origins allowed to call the API. Normally unnecessary: the
# packaged app is served same-origin, and `npm run dev` proxies /api so the
# browser only ever sees one origin.
# WAE_CORS_ORIGINS=http://localhost:5185,http://127.0.0.1:5185

# NOTE: API keys are NOT set here. PageSpeed / Claude / Google Places keys are
# entered in the app's Settings page and stored server-side in
# data/config/engine.json, so they are never exposed to the browser.
